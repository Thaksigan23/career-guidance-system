PORT=5000

# ---- Supabase ----
# Project URL: Supabase Dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: Project Settings → API Keys → service_role (KEEP SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

JWT_SECRET=replace-with-strong-secret
EMAIL_USER=replace@example.com
EMAIL_PASS=replace-app-password
OPENAI_API_KEY=replace-openai-key

# Comma-separated origins for CORS allow-list
CORS_ORIGINS=http://localhost:5173
